# PulseCare HMS - Backend Environment Configuration

# Application Environment (development, test, production)
NODE_ENV=development

# Server Port
PORT=4451

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/hms

# Redis Configuration (Optional in development - in-memory fallback available)
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets (Must be changed in production!)
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production

# Logging Level (error, warn, info, debug)
LOG_LEVEL=info

# AWS Cloud Services Configuration (Optional for local development)
AWS_REGION=us-east-1
AWS_SECRET_NAME=hms/app-secrets
AWS_SES_FROM_EMAIL=noreply@pulsecare.local
AWS_S3_BUCKET=pulsecare-dev-bucket
